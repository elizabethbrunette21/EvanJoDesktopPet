<windowing:TransparentPetWindow x:Class="EvanJoDesktopPet.Windows.Features.DesktopPet.DesktopPetWindow"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:evanJo="clr-namespace:EvanJoDesktopPet.Windows.Characters.EvanJo.Views"
                                xmlns:windowing="clr-namespace:EvanJoDesktopPet.Windows.Platform.Windowing"
                                Title="EvanJoDesktopPet"
                                SizeToContent="WidthAndHeight"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                WindowStartupLocation="Manual">
    <windowing:TransparentPetWindow.Resources>
        <Style x:Key="PetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FCFCFA" />
            <Setter Property="BorderBrush" Value="#DDE6E2" />
            <Setter Property="Foreground" Value="#263630" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="222" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="7">
                            <Border.Effect>
                                <DropShadowEffect Color="#263630" BlurRadius="18"
                                                  ShadowDepth="4" Opacity="0.18" />
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#263630" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBackground" Background="Transparent"
                                CornerRadius="7" Padding="10,7">
                            <Grid Width="190">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SelectedDot" Width="7" Height="7"
                                         Fill="#B43662" Visibility="Collapsed"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FCECF1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FCECF1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ItemBackground" Property="Background" Value="#FBE2EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#84928B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetMenuSectionStyle" TargetType="Separator">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <TextBlock Text="{TemplateBinding Tag}" Foreground="#61756A"
                                   FontSize="10" FontWeight="SemiBold" Margin="28,14,0,8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E8EEEA" Margin="9,7" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </windowing:TransparentPetWindow.Resources>
    <Grid x:Name="PetSurface"
          MouseLeftButtonDown="PetSurface_OnMouseLeftButtonDown"
          MouseLeftButtonUp="PetSurface_OnMouseLeftButtonUp"
          MouseMove="PetSurface_OnMouseMove"
          MouseRightButtonUp="PetSurface_OnMouseRightButtonUp">
        <evanJo:EvanJoPoseView x:Name="PoseView"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
    </Grid>
</windowing:TransparentPetWindow>
