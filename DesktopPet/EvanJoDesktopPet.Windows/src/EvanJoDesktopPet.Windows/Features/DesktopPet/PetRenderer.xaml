<UserControl x:Class="EvanJoDesktopPet.Windows.Features.DesktopPet.PetRenderer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="125"
             Height="132"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Image x:Name="PoseImage"
           Stretch="Uniform"
           SnapsToDevicePixels="True"
           UseLayoutRounding="True"
           RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <ScaleTransform x:Name="PresentationScaleTransform" />
        </Image.RenderTransform>
    </Image>
</UserControl>
