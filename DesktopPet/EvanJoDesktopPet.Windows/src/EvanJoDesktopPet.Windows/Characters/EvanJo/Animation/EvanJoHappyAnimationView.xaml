<UserControl x:Class="EvanJoDesktopPet.Windows.Characters.EvanJo.Animation.EvanJoHappyAnimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160"
             Height="148"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Viewbox Stretch="Uniform">
        <Canvas Width="190"
                Height="166"
                ClipToBounds="True">
            <Canvas x:Name="CharacterLayer"
                    Width="190"
                    Height="166">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="CharacterTranslateTransform" />
                </Canvas.RenderTransform>

                <Image x:Name="BodyImage"
                       Canvas.Left="22.5"
                       Canvas.Top="49.5"
                       Width="145"
                       Height="145"
                       Stretch="Uniform" />

                <Image x:Name="HeadImage"
                       Canvas.Left="22.5"
                       Canvas.Top="0.5"
                       Width="145"
                       Height="145"
                       Stretch="Uniform" />
            </Canvas>

            <Image x:Name="JumpLinesImage"
                   Canvas.Left="22.5"
                   Canvas.Top="40.5"
                   Width="145"
                   Height="145"
                   Opacity="0"
                   Stretch="Uniform" />

            <Image x:Name="Flower01Image"
                   Canvas.Left="17"
                   Canvas.Top="13"
                   Width="156"
                   Height="156"
                   Clip="M 20.28,24.96 H 40.56 V 45.24 H 20.28 Z"
                   Opacity="0"
                   RenderTransformOrigin="0.195,0.225"
                   Stretch="Uniform">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Flower01ScaleTransform"
                                        ScaleX="0.4"
                                        ScaleY="0.4" />
                        <TranslateTransform x:Name="Flower01TranslateTransform" />
                    </TransformGroup>
